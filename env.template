# ============================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values
# Command: cp env.template .env
# DO NOT commit .env to git (it's already in .gitignore)

# ============================================
# FRONTEND VARIABLES (Vite reads VITE_* prefix)
# ============================================

# Stripe Publishable Key (Frontend - Public)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PUBLISHABLE_KEY_HERE

# Backend API URL (Frontend uses this to call backend)
# For local development: http://localhost:3001
# For production: https://api.mycomedic.com
VITE_API_URL=http://localhost:3001

# ============================================
# BACKEND VARIABLES (Express/Node.js reads all)
# ============================================

# Stripe Secret Key (Backend - Keep Secret!)
STRIPE_SECRET_KEY=sk_live_YOUR_SECRET_KEY_HERE

# Frontend URL (Backend uses this for Stripe redirects)
# For local development: http://localhost:5173
# For production: https://www.mycomedic.com.my
CLIENT_URL=http://localhost:5173

# Backend Server Port
PORT=3001

# Environment
NODE_ENV=development

# ============================================
# EMAIL CONFIGURATION (Backend)
# ============================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# ============================================
# LALAMOVE API (Backend - Optional)
# ============================================
# Leave empty if not using Lalamove - system will use default fees
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_BASE_URL=https://rest.lalamove.com

# ============================================
# OFFICE ADDRESS (Backend - for delivery fees)
# ============================================
OFFICE_ADDRESS=NO, 2A-G, FLOOR JALAN SIERRA 10/3, SECTION, Bandar 16 Sierra
OFFICE_CITY=Puchong
OFFICE_POSTCODE=47120
OFFICE_STATE=Selangor
OFFICE_COUNTRY=MY
OFFICE_LAT=3.0167
OFFICE_LNG=101.6167

