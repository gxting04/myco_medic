# Stripe Configuration
# For TEST mode, use keys starting with pk_test_ and sk_test_
# For LIVE mode, use keys starting with pk_live_ and sk_live_

# Frontend Publishable Key (starts with pk_live_ for production)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_LIVE_PUBLISHABLE_KEY_HERE

# Backend Secret Key (starts with sk_live_ for production)
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_SECRET_KEY_HERE

# Client URL - Update this to your production URL
CLIENT_URL=https://your-production-domain.com

# Server Port
PORT=3001
